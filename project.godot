; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Let's Go For Vrouves"
config/description="A cute top-down tower defence: the villagers of Zoniana defend their vrouves."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.47, 0.8, 0.35, 1)
config/icon="res://art/icon.png"

[autoload]

Data="*res://scripts/data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=1024
window/size/window_width_override=1120
window/size/window_height_override=896
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://art/fonts/NotoSans-Bold.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.1, 0.12, 0.1, 1)
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"mipmaps/generate": true
}
